+        </label>
+
+        <div className="ad-modal-actions">
+          <button type="button" className="ad-cancel" onClick={onClose} disabled={busy}>
+            {a.cancel}
+          </button>
+          <button type="submit" className="ad-submit" disabled={busy}>
+            {busy ? <LoaderCircle className="ad-spin" size={15} /> : c.saveBalanceBtn}
+          </button>
+        </div>
+      </form>
+    </WalletModal>
+  );
