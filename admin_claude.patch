+"use client";
+
+import { useMemo, useState } from "react";
+import {
+  Activity, Check, Coins, Copy, Cpu, Eye, EyeOff, KeyRound,
+  LoaderCircle, Pause, Play, Plus, RefreshCw, Search, ShieldCheck,
+  Sparkles, Trash2, TriangleAlert, Vault, X,
+} from "lucide-react";
+import type {
+  AdminClaudeData, AdminClaudeUsageRow, AdminTokenAccountRow, AdminTokenModel,
+} from "@/lib/admin";
+import { useA } from "@/components/livka/i18n-context";
+import { WalletModal } from "@/components/livka/wallet-primitives";
+import { formatTokens } from "@/lib/tokens-shared";
+
+type ClaudeSubTab = "keys" | "models" | "bank" | "logs";
+type KeyFilter = "all" | "active" | "paused";
+
+export function AdminClaudePanel({
+  claude,
+  usersList = [],
+  onChanged,
+}: {
+  claude: AdminClaudeData;
+  usersList?: { id: string; customerId: string; name: string; email: string }[];
+  onChanged: (toast: string) => Promise<void>;
+}) {
+  const { a } = useA();
+  const c = a.claude;
+
+  const [subTab, setSubTab] = useState<ClaudeSubTab>("keys");
+  const [filter, setFilter] = useState<KeyFilter>("all");
+  const [query, setQuery] = useState("");
+  const [revealedKeys, setRevealedKeys] = useState<Record<string, boolean>>({});
+  const [copiedKey, setCopiedKey] = useState<string | null>(null);
+
+  // Modals state
+  const [issueOpen, setIssueOpen] = useState(false);
+  const [balanceModal, setBalanceModal] = useState<AdminTokenAccountRow | null>(null);
+  const [regenModal, setRegenModal] = useState<AdminTokenAccountRow | null>(null);
+  const [deleteModal, setDeleteModal] = useState<AdminTokenAccountRow | null>(null);
+
+  const toggleReveal = (id: string) => {
+    setRevealedKeys((prev) => ({ ...prev, [id]: !prev[id] }));
+  };
+
+  const copyToClipboard = async (text: string, id: string) => {
+    try {
+      await navigator.clipboard.writeText(text);
+      setCopiedKey(id);
+      setTimeout(() => setCopiedKey(null), 2000);
+    } catch {
+      // fallback
+    }
+  };
+
+  const filteredAccounts = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    return claude.accounts.filter((acc) => {
+      if (filter === "active" && (!acc.isActive || acc.status !== "active")) return false;
+      if (filter === "paused" && acc.isActive && acc.status === "active") return false;
+      if (!q) return true;
+      return (
+        acc.name.toLowerCase().includes(q) ||
+        acc.email.toLowerCase().includes(q) ||
+        acc.customerId.toLowerCase().includes(q) ||
+        acc.apiKey.toLowerCase().includes(q) ||
+        (acc.label && acc.label.toLowerCase().includes(q))
+      );
+    });
+  }, [claude.accounts, filter, query]);
+
+  const toggleAccountStatus = async (account: AdminTokenAccountRow) => {
+    try {
+      const res = await fetch("/api/admin/claude", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          action: "toggle-active",
+          accountId: account.id,
+          isActive: !account.isActive,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error ?? "SERVER");
+      await onChanged(account.isActive ? c.keyPaused : c.keyActive);
+    } catch (e) {
+      alert(e instanceof Error ? e.message : "Error");
+    }
+  };
+
+  const quickSetBalance = async (account: AdminTokenAccountRow, amount: number) => {
+    const label = amount === 0 ? "обнулить баланс" : `установить баланс ${amount.toLocaleString()} токенов`;
+    if (!window.confirm(`Вы уверены, что хотите ${label} для ${account.name}?`)) return;
+    try {
+      const res = await fetch("/api/admin/claude", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          action: "update-balance",
+          accountId: account.id,
+          mode: "set",
+          amountTokens: amount,
+          note: `Quick set ${amount} tokens`,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error ?? "SERVER");
+      await onChanged(`Баланс ${account.name}: ${amount.toLocaleString()} токенов`);
+    } catch (e) {
+      alert(e instanceof Error ? e.message : "Error");
+    }
+  };
+
+  return (
+    <div className="ad-claude-space">
+      {/* ── Top Stat Cards ── */}
+      <section className="ad-stats ad-stats-4">
+        <article>
+          <span className="violet"><KeyRound /></span>
+          <div>
+            <small>{c.cActiveKeys}</small>
+            <b>{claude.stats.activeAccounts} <span className="ad-stat-sub">/ {claude.stats.totalAccounts}</span></b>
+            <p>{c.cActiveKeysNote}</p>
+          </div>
+        </article>
+        <article>
+          <span className="mint"><Coins /></span>
+          <div>
+            <small>{c.cCirculation}</small>
+            <b>{formatTokens(claude.stats.tokensInCirculation)}</b>
+            <p>{c.cCirculationNote}</p>
+          </div>
+        </article>
+        <article>
+          <span className="rose"><Activity /></span>
+          <div>
+            <small>{c.cConsumed}</small>
+            <b>{formatTokens(claude.stats.totalConsumed)}</b>
+            <p>{c.cConsumedNote}</p>
+          </div>
+        </article>
+        <article>
+          <span className="amber"><Vault /></span>
+          <div>
+            <small>{c.cBankPool}</small>
+            <b>{formatTokens(claude.stats.bankAvailable)}</b>
+            <p>{c.cBankPoolNote}</p>
+          </div>
+        </article>
+      </section>
+
+      {/* ── Main Navigation & Tabs ── */}
+      <section className="ad-card ad-claude-card">
+        <div className="ad-card-head">
+          <div className="ad-claude-head-tabs">
+            <button
+              className={`ad-subtab ${subTab === "keys" ? "active" : ""}`}
+              onClick={() => setSubTab("keys")}
+            >
+              <KeyRound size={15} />
+              {c.keysTitle}
+              <i>{claude.accounts.length}</i>
+            </button>
+            <button
+              className={`ad-subtab ${subTab === "models" ? "active" : ""}`}
+              onClick={() => setSubTab("models")}
+            >
+              <Cpu size={15} />
+              {c.modelsTitle}
+              <i>{claude.models.length}</i>
+            </button>
+            <button
+              className={`ad-subtab ${subTab === "bank" ? "active" : ""}`}
+              onClick={() => setSubTab("bank")}
+            >
+              <Vault size={15} />
+              {c.bankTitle}
+            </button>
+            <button
+              className={`ad-subtab ${subTab === "logs" ? "active" : ""}`}
+              onClick={() => setSubTab("logs")}
+            >
+              <Activity size={15} />
+              {c.recentLogsTitle}
+              <i>{claude.recentUsage.length}</i>
+            </button>
+          </div>
+
+          {subTab === "keys" && (
+            <button className="ad-cta-btn" onClick={() => setIssueOpen(true)}>
+              <Plus size={15} />
+              {c.issueKeyBtn}
+            </button>
+          )}
+        </div>
+
+        {/* ── Subtab 1: Keys ── */}
+        {subTab === "keys" && (
+          <div className="ad-claude-keys">
+            <div className="ad-claude-filter-bar">
+              <div className="ad-search-inline">
+                <Search size={15} />
+                <input
+                  value={query}
+                  onChange={(e) => setQuery(e.target.value)}
+                  placeholder={c.searchKeysPh}
+                />
+                {query && (
+                  <button onClick={() => setQuery("")} className="ad-clear-btn">
+                    <X size={13} />
+                  </button>
+                )}
+              </div>
+
+              <div className="ad-segment" role="tablist">
+                <button
+                  className={filter === "all" ? "active" : ""}
+                  onClick={() => setFilter("all")}
+                >
+                  {c.fAll} <i>{claude.accounts.length}</i>
+                </button>
+                <button
+                  className={filter === "active" ? "active" : ""}
+                  onClick={() => setFilter("active")}
+                >
+                  {c.fActive} <i>{claude.accounts.filter((x) => x.isActive && x.status === "active").length}</i>
+                </button>
+                <button
+                  className={filter === "paused" ? "active" : ""}
+                  onClick={() => setFilter("paused")}
+                >
+                  {c.fPaused} <i>{claude.accounts.filter((x) => !x.isActive || x.status !== "active").length}</i>
+                </button>
+              </div>
+            </div>
+
+            {filteredAccounts.length ? (
+              <div className="ad-table ad-claude-table">
+                <div className="ad-tr ad-th ad-claude-tr">
+                  <span>{c.colUser}</span>
+                  <span>{c.colKey}</span>
+                  <span>{c.colBalance}</span>
+                  <span>{c.colUsage}</span>
+                  <span>{c.colStatus}</span>
+                  <span>{c.colActions}</span>
+                </div>
+
+                {filteredAccounts.map((account) => {
+                  const isRevealed = !!revealedKeys[account.id];
+                  const isCopied = copiedKey === account.id;
+                  const isKeyActive = account.isActive && account.status === "active";
+
+                  return (
+                    <div key={account.id} className="ad-tr ad-claude-tr">
+                      {/* User Column */}
+                      <div className="ad-user">
+                        <span className="ad-avatar">{account.name[0]?.toUpperCase() ?? "U"}</span>
+                        <span>
+                          <b>{account.name}</b>
+                          <small>{account.email} · <span className="ad-cust-badge">{account.customerId}</span></small>
+                          {account.label && <span className="ad-key-label">{account.label}</span>}
+                        </span>
+                      </div>
+
+                      {/* API Key Column */}
+                      <div className="ad-key-col">
+                        <code className="ad-key-box">
+                          {isRevealed
+                            ? account.apiKey
+                            : `${account.apiKey.slice(0, 15)}...${account.apiKey.slice(-6)}`}
+                        </code>
+                        <div className="ad-key-btns">
+                          <button
+                            title={isRevealed ? "Hide" : "Show"}
+                            onClick={() => toggleReveal(account.id)}
+                            className="ad-key-btn"
+                          >
+                            {isRevealed ? <EyeOff size={13} /> : <Eye size={13} />}
+                          </button>
+                          <button
+                            title="Copy key"
+                            onClick={() => copyToClipboard(account.apiKey, account.id)}
+                            className={`ad-key-btn ${isCopied ? "copied" : ""}`}
+                          >
+                            {isCopied ? <Check size={13} /> : <Copy size={13} />}
+                          </button>
+                        </div>
+                      </div>
+
+                      {/* Token Balance */}
+                      <div className="ad-balance-col">
+                        <b>{account.totalTokens.toLocaleString()}</b>
+                        <small>
+                          Out: {account.outputTokens.toLocaleString()} · In: {account.inputTokens.toLocaleString()}
+                        </small>
+                      </div>
+
+                      {/* Usage */}
+                      <div className="ad-usage-col">
+                        <b>{account.requestsCount} req</b>
+                        <small>{formatTokens(account.tokensConsumed)} used</small>
+                      </div>
+
+                      {/* Status */}
+                      <div>
+                        <span className={`ad-status ${isKeyActive ? "active" : "banned"}`}>
+                          {isKeyActive ? c.keyActive : c.keyPaused}
+                        </span>
+                      </div>
+
+                      {/* Actions */}
+                      <div className="ad-actions">
+                        <button
+                          type="button"
+                          title="Быстро установить ровно 1 000 000 токенов"
+                          onClick={() => quickSetBalance(account, 1_000_000)}
+                          className="ad-quick-btn"
+                        >
+                          1M
+                        </button>
+                        <button
+                          type="button"
+                          title="Быстро обнулить баланс токенов (0)"
+                          onClick={() => quickSetBalance(account, 0)}
+                          className="ad-quick-btn danger"
+                        >
+                          0
+                        </button>
+                        <button
+                          title={c.editBalance}
+                          onClick={() => setBalanceModal(account)}
+                          className="ad-btn-icon"
+                        >
+                          <Coins size={15} />
+                        </button>
+                        <button
+                          title={c.regenKey}
+                          onClick={() => setRegenModal(account)}
+                          className="ad-btn-icon"
+                        >
+                          <RefreshCw size={14} />
+                        </button>
+                        <button
+                          title={account.isActive ? c.pauseKey : c.resumeKey}
+                          onClick={() => toggleAccountStatus(account)}
+                          className={`ad-btn-icon ${account.isActive ? "warning" : "success"}`}
+                        >
+                          {account.isActive ? <Pause size={14} /> : <Play size={14} />}
+                        </button>
+                        <button
+                          title={c.deleteKey}
+                          onClick={() => setDeleteModal(account)}
+                          className="ad-btn-icon danger"
+                        >
+                          <Trash2 size={14} />
+                        </button>
+                      </div>
+                    </div>
+                  );
+                })}
+              </div>
+            ) : (
+              <div className="ad-empty">
+                <KeyRound size={32} />
+                <b>{c.noKeys}</b>
+                <p>{c.noKeysHint}</p>
+              </div>
+            )}
+          </div>
+        )}
+
+        {/* ── Subtab 2: Models & Tariffs ── */}
+        {subTab === "models" && (
+          <ModelsPanel models={claude.models} onChanged={onChanged} />
+        )}
+
+        {/* ── Subtab 3: Token Bank Pool ── */}
+        {subTab === "bank" && (
+          <BankPanel stats={claude.stats} onChanged={onChanged} />
+        )}
+
+        {/* ── Subtab 4: Live Logs ── */}
+        {subTab === "logs" && (
+          <LogsPanel logs={claude.recentUsage} />
+        )}
+      </section>
+
+      {/* ── Issue Key Modal ── */}
+      {issueOpen && (
+        <IssueKeyModal
+          usersList={usersList}
+          onClose={() => setIssueOpen(false)}
+          onDone={async (text) => {
+            setIssueOpen(false);
+            await onChanged(text);
+          }}
+        />
+      )}
+
+      {/* ── Edit Balance Modal ── */}
+      {balanceModal && (
+        <EditBalanceModal
+          account={balanceModal}
+          onClose={() => setBalanceModal(null)}
+          onDone={async (text) => {
+            setBalanceModal(null);
+            await onChanged(text);
+          }}
+        />
+      )}
+
+      {/* ── Regenerate Key Modal ── */}
+      {regenModal && (
+        <RegenKeyModal
+          account={regenModal}
+          onClose={() => setRegenModal(null)}
+          onDone={async (text) => {
+            setRegenModal(null);
+            await onChanged(text);
+          }}
+        />
+      )}
+
+      {/* ── Delete Key Modal ── */}
+      {deleteModal && (
+        <DeleteKeyModal
+          account={deleteModal}
+          onClose={() => setDeleteModal(null)}
+          onDone={async (text) => {
+            setDeleteModal(null);
+            await onChanged(text);
+          }}
+        />
+      )}
+    </div>
+  );
+}
+
+/* ═══════════ SUB-PANELS ═══════════ */
+
+function ModelsPanel({
+  models,
+  onChanged,
+}: {
+  models: AdminTokenModel[];
+  onChanged: (text: string) => Promise<void>;
+}) {
+  const { a } = useA();
+  const c = a.claude;
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [inputRateCents, setInputRateCents] = useState(30);
+  const [outputRateCents, setOutputRateCents] = useState(30);
+  const [isActive, setIsActive] = useState(true);
+  const [busy, setBusy] = useState(false);
+
+  const startEdit = (m: AdminTokenModel) => {
+    setEditingId(m.id);
+    setInputRateCents(m.inputPerMillionCents);
+    setOutputRateCents(m.outputPerMillionCents);
+    setIsActive(m.isActive);
+  };
+
+  const saveModel = async (model: AdminTokenModel) => {
+    setBusy(true);
+    try {
+      const res = await fetch("/api/admin/claude", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          action: "update-model",
+          modelId: model.id,
+          inputRateCents,
+          outputRateCents,
+          isActive,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error ?? "SERVER");
+      setEditingId(null);
+      await onChanged(`${model.label}: ${c.saveModel}`);
+    } catch (e) {
+      alert(e instanceof Error ? e.message : "Error");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="ad-claude-models-view">
+      <div className="ad-card-head-sub">
+        <div>
+          <h3>{c.modelsTitle}</h3>
+          <p>{c.modelsSubtitle}</p>
+        </div>
+      </div>
+
+      <div className="ad-models-grid">
+        {models.map((model) => {
+          const isEditing = editingId === model.id;
+          return (
+            <article key={model.id} className={`ad-model-card ${model.isActive ? "" : "is-disabled"}`}>
+              <div className="ad-model-top">
+                <span className="ad-model-icon"><Cpu size={22} /></span>
+                <div>
+                  <h4>{model.label}</h4>
+                  <code>{model.slug}</code>
+                </div>
+                <span className={`ad-status ${model.isActive ? "active" : "hidden"}`}>
+                  {model.isActive ? c.modelActive : c.modelDisabled}
+                </span>
+              </div>
+
+              <div className="ad-model-body">
+                {isEditing ? (
+                  <div className="ad-model-edit-form">
+                    <label>
+                      <span>Input rate per 1M tokens ($):</span>
+                      <div className="ad-rate-input-wrap">
+                        <span>$</span>
+                        <input
+                          type="number"
+                          step="0.01"
+                          min="0.01"
+                          value={(inputRateCents / 100).toFixed(2)}
+                          onChange={(e) => setInputRateCents(Math.round(parseFloat(e.target.value || "0") * 100))}
+                        />
+                      </div>
+                    </label>
+
+                    <label style={{ marginTop: "8px" }}>
+                      <span>Output rate per 1M tokens ($):</span>
+                      <div className="ad-rate-input-wrap">
+                        <span>$</span>
+                        <input
+                          type="number"
+                          step="0.01"
+                          min="0.01"
+                          value={(outputRateCents / 100).toFixed(2)}
+                          onChange={(e) => setOutputRateCents(Math.round(parseFloat(e.target.value || "0") * 100))}
+                        />
+                      </div>
+                    </label>
+
+                    <label className="ad-checkbox-label">
+                      <input
+                        type="checkbox"
+                        checked={isActive}
+                        onChange={(e) => setIsActive(e.target.checked)}
+                      />
+                      <span>Active for customer purchase</span>
+                    </label>
+
+                    <div className="ad-model-actions">
+                      <button
+                        className="ad-cancel"
+                        disabled={busy}
+                        onClick={() => setEditingId(null)}
+                      >
+                        {a.cancel}
+                      </button>
+                      <button
+                        className="ad-submit"
+                        disabled={busy}
+                        onClick={() => saveModel(model)}
+                      >
+                        {busy ? <LoaderCircle className="ad-spin" size={14} /> : c.saveModel}
+                      </button>
+                    </div>
+                  </div>
+                ) : (
+                  <>
+                    <div className="ad-model-rate-display">
+                      <small>{c.ratePer1M}</small>
+                      <b>
+                        ${(model.inputPerMillionCents / 100).toFixed(2)} in · ${(model.outputPerMillionCents / 100).toFixed(2)} out
+                      </b>
+                      <p>Per 1,000,000 input / output tokens</p>
+                    </div>
+
+                    <div className="ad-model-footer">
+                      <button className="ad-model-edit-btn" onClick={() => startEdit(model)}>
+                        Edit Price & Status
+                      </button>
+                    </div>
+                  </>
+                )}
+              </div>
