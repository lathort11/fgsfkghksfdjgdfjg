+      <form onSubmit={submit}>
+        <div className="ad-segment ad-mode-segment">
+          <button
+            type="button"
+            className={mode === "add" ? "active" : ""}
+            onClick={() => setMode("add")}
+          >
+            {c.balanceAdd}
+          </button>
+          <button
+            type="button"
+            className={mode === "subtract" ? "active" : ""}
+            onClick={() => setMode("subtract")}
+          >
+            {c.balanceSubtract}
+          </button>
+          <button
+            type="button"
+            className={mode === "set" ? "active" : ""}
+            onClick={() => setMode("set")}
+          >
+            {c.balanceSet}
+          </button>
+        </div>
+
+        <label className="ad-field">
+          <span>{c.tokensAmount}</span>
+          <div>
+            <input
+              type="number"
+              min="0"
+              step="500000"
+              value={amount}
+              onChange={(e) => setAmount(e.target.value)}
+            />
+            <span>tokens</span>
+          </div>
+        </label>
+
+        <div className="ad-quick-tokens">
+          {mode === "set" &&
+            [0, 1_000_000, 5_000_000, 10_000_000, 35_000_000].map((amt) => (
+              <button
+                type="button"
+                key={amt}
+                onClick={() => setAmount(String(amt))}
+                className={amount === String(amt) ? "active" : ""}
+              >
+                {amt === 0 ? `0 (${c.quickZero})` : formatTokens(amt)}
+              </button>
+            ))}
+          {mode === "add" &&
+            [500_000, 1_000_000, 5_000_000, 10_000_000, 25_000_000].map((amt) => (
+              <button
+                type="button"
+                key={amt}
+                onClick={() => setAmount(String(amt))}
+                className={amount === String(amt) ? "active" : ""}
+              >
+                +{formatTokens(amt)}
+              </button>
+            ))}
+          {mode === "subtract" &&
+            [500_000, 1_000_000, 5_000_000, account.totalTokens].filter(Boolean).map((amt) => (
+              <button
+                type="button"
+                key={amt}
+                onClick={() => setAmount(String(amt))}
+                className={amount === String(amt) ? "active" : ""}
+              >
+                {amt === account.totalTokens ? `Всё (${formatTokens(amt)})` : `-${formatTokens(amt)}`}
+              </button>
+            ))}
+        </div>
+
+        <div className="ad-price-preview">
+          <div>
+            <small>Current Balance</small>
+            <b>{account.totalTokens.toLocaleString()}</b>
+          </div>
+          <span>→</span>
+          <div>
+            <small>After Adjustment ({mode === "set" ? "exact" : mode === "add" ? "+" : "-"})</small>
+            <b style={{ color: mode === "set" ? "#b49af2" : mode === "add" ? "#82c4a5" : "#cc909e" }}>
+              {preview.toLocaleString()}
+            </b>
+          </div>
+        </div>
+
+        <label className="ad-field">
+          <span>Note / reason:</span>
+          <input
+            type="text"
+            value={note}
