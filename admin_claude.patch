+function IssueKeyModal({
+  usersList,
+  onClose,
+  onDone,
+}: {
+  usersList: { id: string; customerId: string; name: string; email: string }[];
+  onClose: () => void;
+  onDone: (text: string) => Promise<void>;
+}) {
+  const { a } = useA();
+  const c = a.claude;
+
+  const [selectedUser, setSelectedUser] = useState(usersList[0]?.id ?? "");
+  const [tokens, setTokens] = useState("1000000");
+  const [balanceMode, setBalanceMode] = useState<"replace" | "add">("replace");
+  const [label, setLabel] = useState("");
+  const [note, setNote] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [searchU, setSearchU] = useState("");
+
+  const filteredUsers = useMemo(() => {
+    const q = searchU.trim().toLowerCase();
+    if (!q) return usersList;
+    return usersList.filter(
+      (u) =>
+        u.name.toLowerCase().includes(q) ||
+        u.email.toLowerCase().includes(q) ||
+        u.customerId.toLowerCase().includes(q)
+    );
+  }, [usersList, searchU]);
+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!selectedUser || busy) return;
+    setBusy(true);
+
+    try {
+      const res = await fetch("/api/admin/claude", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          action: "issue-key",
+          userId: selectedUser,
+          initialTokens: parseInt(tokens, 10) || 0,
+          balanceMode,
+          label: label.trim() || undefined,
+          note: note.trim() || undefined,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error ?? "SERVER");
+      await onDone(`API-key issued successfully (${data.result?.apiKey?.slice(0, 15)}...)`);
+    } catch (err) {
+      alert(err instanceof Error ? err.message : "Error");
+      setBusy(false);
+    }
+  };
+
+  return (
+    <WalletModal title={c.issueModalTitle} subtitle="Generate new lvk-claude- key" onClose={onClose}>
+      <form onSubmit={submit}>
+        <label className="ad-field">
+          <span>{c.selectUser}</span>
+          <input
+            type="text"
+            className="ad-search-user-input"
+            placeholder="Filter users by name or email…"
+            value={searchU}
+            onChange={(e) => setSearchU(e.target.value)}
+          />
+          <select
+            value={selectedUser}
+            onChange={(e) => setSelectedUser(e.target.value)}
+            required
+            className="ad-user-select"
+          >
+            {filteredUsers.map((u) => (
+              <option key={u.id} value={u.id}>
+                {u.name} ({u.email}) · {u.customerId}
+              </option>
+            ))}
+          </select>
+        </label>
+
+        <label className="ad-field">
+          <span>{c.balanceMode}</span>
+          <div className="ad-segment ad-mode-segment" style={{ marginTop: "6px" }}>
+            <button
+              type="button"
+              className={balanceMode === "replace" ? "active" : ""}
+              onClick={() => setBalanceMode("replace")}
+            >
+              {c.balanceModeReplace}
+            </button>
+            <button
+              type="button"
+              className={balanceMode === "add" ? "active" : ""}
+              onClick={() => setBalanceMode("add")}
+            >
+              {c.balanceModeAdd}
+            </button>
+          </div>
+        </label>
+
+        <label className="ad-field">
+          <span>{c.initialTokens}</span>
+          <div>
+            <input
+              type="number"
+              min="0"
+              step="100000"
+              value={tokens}
+              onChange={(e) => setTokens(e.target.value)}
+            />
+            <span>tokens</span>
+          </div>
+        </label>
+
+        <div className="ad-quick-tokens">
+          {[0, 500_000, 1_000_000, 5_000_000, 10_000_000, 35_000_000].map((amt) => (
+            <button
+              type="button"
+              key={amt}
+              onClick={() => setTokens(String(amt))}
+              className={tokens === String(amt) ? "active" : ""}
+            >
+              {amt === 0 ? "0" : formatTokens(amt)}
+            </button>
+          ))}
+        </div>
+
+        <label className="ad-field">
+          <span>{c.keyLabel}</span>
+          <input
+            type="text"
+            value={label}
+            onChange={(e) => setLabel(e.target.value)}
+            placeholder={c.keyLabelPh}
+            className="ad-password-confirm"
+          />
+        </label>
+
+        <div className="ad-modal-actions">
+          <button type="button" className="ad-cancel" onClick={onClose} disabled={busy}>
+            {a.cancel}
+          </button>
+          <button type="submit" className="ad-submit" disabled={busy || !selectedUser}>
+            {busy ? <LoaderCircle className="ad-spin" size={15} /> : <><Sparkles size={15} />{c.issueBtn}</>}
+          </button>
+        </div>
+      </form>
+    </WalletModal>
+  );
+}
