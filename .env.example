# PostgreSQL connection used by Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Base URL of the LIVKAMARKET Telegram bot backend that serves
# POST /miniapp/api/verify-ip (used by the /miniapp page).
#
# The browser calls this URL directly, so it is PUBLIC: never put tokens,
# passwords or the bot token here. It must be https:// (http:// is accepted
# only for localhost during development).
#
# - Leave EMPTY when a reverse proxy on the same domain routes /miniapp/api/*
#   to the backend. Same origin, no CORS needed.
# - Set to e.g. https://bot.example.com when the backend is on another domain.
#   The backend must then allow this site's origin via CORS (see docs).
#
# Read at request time by src/app/miniapp/page.tsx; restart the server after
# changing it. Do NOT point it at this Next.js app: the backend has to see the
# user's real IP from its own reverse proxy.
MINIAPP_BACKEND_URL=
